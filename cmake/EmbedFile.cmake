# Converts a file into a C++ source defining its bytes as a constant array,
# so data the engine needs at run time is compiled into the binary instead
# of being looked up on disk.
#
# Run in script mode:
#   cmake -DINPUT=file -DOUTPUT=file.cc -DSYMBOL=name -DNAMESPACE=ns
#         -P EmbedFile.cmake
#
# Defines, in namespace NAMESPACE:
#   extern const unsigned char SYMBOL[];         // the bytes, NUL-terminated
#   extern const std::size_t SYMBOL_size;        // excluding the NUL
# A byte array rather than a string literal because C++ only guarantees
# string literals of 65,536 characters (clang -Wpedantic warns beyond that).

foreach(var INPUT OUTPUT SYMBOL NAMESPACE)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "EmbedFile.cmake: ${var} is not set")
  endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
# Sixteen bytes per line keeps the generated file diffable and the lines
# short.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# CMake regexes have no {n} repetition, so the 16-byte pattern is spelled
# out.
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 line_pattern)
string(REGEX REPLACE "(${line_pattern})" "\\1\n    " bytes "${bytes}")
get_filename_component(input_name "${INPUT}" NAME)

file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedFile.cmake from ${input_name}. Do not edit.

#include <cstddef>

namespace ${NAMESPACE} {

extern const unsigned char ${SYMBOL}[];
extern const std::size_t ${SYMBOL}_size;

alignas(8) const unsigned char ${SYMBOL}[] = {
    ${bytes}0x00};
const std::size_t ${SYMBOL}_size = ${size};

}  // namespace ${NAMESPACE}
")
# Only touch OUTPUT when the content changed, so an unchanged input does
# not force a recompile.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
